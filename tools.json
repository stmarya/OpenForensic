{
  "schemaVersion": 1,
  "toolkitVersion": "0.1.0",
  "description": "Manifest deklaratif tool OpenForensic / Kan9Ch3k. Placeholder {file} diganti path absolut file target, {plugin} diganti plugin terpilih.",
  "tools": [
    {
      "id": "vol",
      "name": "Volatility 3",
      "description": "Analisis memori (RAM dump): proses, koneksi jaringan, file, injeksi kode",
      "category": "memory",
      "command": "vol.exe",
      "lookup": "auto",
      "kinds": ["memdump", "crashdump"],
      "extensions": [".dmp", ".raw", ".vmem", ".mem", ".img", ".lime", ".core", ".vmss", ".vmsn"],
      "args": ["-f", "{file}", "{plugin}"],
      "plugin": {
        "required": true,
        "default": "windows.info",
        "choices": [
          "windows.info",
          "windows.pslist",
          "windows.pstree",
          "windows.cmdline",
          "windows.netscan",
          "windows.netstat",
          "windows.filescan",
          "windows.malfind",
          "windows.dlllist",
          "windows.hashdump",
          "windows.registry.hivelist",
          "windows.envars",
          "linux.pslist",
          "mac.pslist"
        ]
      },
      "autoTriage": true,
      "triage": ["windows.info", "windows.pslist", "windows.netscan", "windows.cmdline", "windows.malfind"],
      "optional": false,
      "install": "pip install volatility3 (otomatis via setup_tools.ps1)"
    },
    {
      "id": "oleid",
      "name": "Oleid",
      "description": "Deteksi cepat indikator berbahaya pada dokumen Office",
      "category": "document",
      "command": "oleid.exe",
      "lookup": "auto",
      "kinds": ["ole", "ooxml", "rtf"],
      "extensions": [".doc", ".xls", ".ppt", ".docx", ".xlsx", ".pptx", ".docm", ".xlsm", ".pptm", ".rtf"],
      "args": ["{file}"],
      "autoTriage": true,
      "optional": false,
      "install": "pip install oletools (otomatis via setup_tools.ps1)"
    },
    {
      "id": "olevba",
      "name": "Olevba",
      "description": "Ekstrak dan analisis macro VBA dari dokumen Office",
      "category": "document",
      "command": "olevba.exe",
      "lookup": "auto",
      "kinds": ["ole", "ooxml", "rtf"],
      "extensions": [".doc", ".xls", ".ppt", ".docx", ".xlsx", ".pptx", ".docm", ".xlsm", ".pptm", ".rtf"],
      "args": ["--decode", "{file}"],
      "autoTriage": true,
      "optional": false,
      "install": "pip install oletools (otomatis via setup_tools.ps1)"
    },
    {
      "id": "mraptor",
      "name": "MacroRaptor",
      "description": "Deteksi macro VBA yang bersifat jahat",
      "category": "document",
      "command": "mraptor.exe",
      "lookup": "auto",
      "kinds": ["ole", "ooxml", "rtf"],
      "extensions": [".doc", ".xls", ".ppt", ".docx", ".xlsx", ".pptx", ".docm", ".xlsm", ".pptm"],
      "args": ["{file}"],
      "autoTriage": true,
      "optional": false,
      "install": "pip install oletools (otomatis via setup_tools.ps1)"
    },
    {
      "id": "rtfobj",
      "name": "RtfObj",
      "description": "Ekstrak objek OLE yang disisipkan di dalam file RTF",
      "category": "document",
      "command": "rtfobj.exe",
      "lookup": "auto",
      "kinds": ["rtf"],
      "extensions": [".rtf"],
      "args": ["{file}"],
      "autoTriage": true,
      "optional": false,
      "install": "pip install oletools (otomatis via setup_tools.ps1)"
    },
    {
      "id": "pycdc",
      "name": "Decompyle++ (pycdc)",
      "description": "Decompiler bytecode Python modern; pengganti uncompyle6 untuk Python >= 3.9",
      "category": "reversing",
      "command": "pycdc.exe",
      "lookup": "auto",
      "kinds": ["pyc"],
      "extensions": [".pyc", ".pyo"],
      "args": ["{file}"],
      "autoTriage": true,
      "optional": true,
      "install": "Build dari https://github.com/zrax/pycdc lalu salin pycdc.exe ke folder bin\\"
    },
    {
      "id": "uncompyle6",
      "name": "Uncompyle6 (legacy)",
      "description": "Decompiler .pyc lama. Tidak dimaintain dan gagal pada Python >= 3.9",
      "category": "reversing",
      "command": "uncompyle6.exe",
      "lookup": "auto",
      "kinds": ["pyc"],
      "extensions": [".pyc", ".pyo"],
      "args": ["{file}"],
      "autoTriage": false,
      "optional": true,
      "install": "pip install uncompyle6 (.\\setup_tools.ps1 -IncludeOptional)"
    },
    {
      "id": "exiftool",
      "name": "ExifTool",
      "description": "Metadata lengkap untuk gambar, PDF, audio, video; sering menyimpan flag CTF",
      "category": "metadata",
      "command": "exiftool",
      "lookup": "auto",
      "kinds": ["png", "jpeg", "gif", "bmp", "pdf", "wav", "*"],
      "args": ["-a", "-u", "-g1", "{file}"],
      "autoTriage": true,
      "optional": false,
      "install": "winget install OliverBetz.ExifTool"
    },
    {
      "id": "strings",
      "name": "Strings (built-in)",
      "description": "Ekstraktor string ASCII + UTF-16LE bawaan toolkit, tanpa dependensi eksternal",
      "category": "generic",
      "command": "Get-OFStrings",
      "lookup": "internal",
      "kinds": ["*"],
      "args": ["-Path", "{file}", "-MinLength", "6"],
      "autoTriage": true,
      "optional": false,
      "install": "built-in"
    },
    {
      "id": "pdfid",
      "name": "PDFiD",
      "description": "Deteksi elemen berbahaya pada PDF (/JS, /OpenAction, /Launch, /EmbeddedFile)",
      "category": "document",
      "command": "pdfid.exe",
      "lookup": "auto",
      "kinds": ["pdf"],
      "extensions": [".pdf"],
      "args": ["{file}"],
      "autoTriage": true,
      "optional": true,
      "install": "pip install pdfid (.\\setup_tools.ps1 -IncludeOptional)"
    },
    {
      "id": "tshark",
      "name": "TShark",
      "description": "Analisis PCAP: statistik protokol, percakapan, ekstraksi objek",
      "category": "network",
      "command": "tshark.exe",
      "lookup": "auto",
      "kinds": ["pcap", "pcapng"],
      "extensions": [".pcap", ".pcapng", ".cap"],
      "args": ["-r", "{file}", "-q", "-z", "io,phs"],
      "autoTriage": true,
      "optional": true,
      "install": "winget install WiresharkFoundation.Wireshark"
    },
    {
      "id": "binwalk",
      "name": "Binwalk",
      "description": "Deteksi & ekstraksi file yang tertanam di dalam binary (carving)",
      "category": "carving",
      "command": "binwalk.exe",
      "lookup": "auto",
      "kinds": ["*"],
      "args": ["-B", "{file}"],
      "autoTriage": false,
      "optional": true,
      "install": "pip install binwalk (.\\setup_tools.ps1 -IncludeOptional)"
    },
    {
      "id": "zsteg",
      "name": "zsteg",
      "description": "Deteksi steganografi LSB pada PNG dan BMP",
      "category": "stego",
      "command": "zsteg.bat",
      "lookup": "auto",
      "kinds": ["png", "bmp"],
      "extensions": [".png", ".bmp"],
      "args": ["-a", "{file}"],
      "autoTriage": false,
      "optional": true,
      "install": "Pasang Ruby lalu: gem install zsteg"
    },
    {
      "id": "steghide",
      "name": "Steghide",
      "description": "Deteksi & ekstraksi payload steghide pada JPEG, BMP, WAV, AU",
      "category": "stego",
      "command": "steghide.exe",
      "lookup": "auto",
      "kinds": ["jpeg", "bmp", "wav"],
      "extensions": [".jpg", ".jpeg", ".bmp", ".wav", ".au"],
      "args": ["info", "{file}"],
      "autoTriage": false,
      "optional": true,
      "install": "Unduh dari https://steghide.sourceforge.net lalu salin ke folder bin\\"
    },
    {
      "id": "7z",
      "name": "7-Zip",
      "description": "Inspeksi isi arsip termasuk deteksi entri terenkripsi",
      "category": "archive",
      "command": "7z.exe",
      "lookup": "auto",
      "kinds": ["zip", "rar", "7z", "gzip"],
      "extensions": [".zip", ".rar", ".7z", ".gz", ".tar", ".jar", ".apk"],
      "args": ["l", "-slt", "{file}"],
      "autoTriage": true,
      "optional": true,
      "install": "winget install 7zip.7zip"
    }
  ]
}
