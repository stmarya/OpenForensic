    {
      "id": "vol",
      "name": "Volatility 3",
      "description": "Analisis memori / RAM dump",
      "category": "memory",
      "phase": "analyze",
      "executable": "vol.exe",
      "source": "bin",
      "builtin": "",
      "extensions": [".dmp", ".raw", ".mem", ".vmem", ".vmss", ".vmsn", ".lime", ".core", ".img"],
      "kinds": ["memdump"],
      "argTemplate": ["-f", "{file}", "{plugin}"],
      "requiresPlugin": true,
      "plugins": ["windows.info", "windows.pslist", "windows.pstree", "windows.cmdline", "windows.netscan", "windows.netstat", "windows.filescan", "windows.malfind", "windows.hashdump", "windows.registry.printkey", "banners"],
      "triage": true,
      "triageArgs": [["-f", "{file}", "windows.info"], ["-f", "{file}", "windows.pslist"], ["-f", "{file}", "windows.netscan"], ["-f", "{file}", "windows.malfind"]],
      "dialogFilter": "Memory dump (*.dmp;*.raw;*.mem;*.vmem)|*.dmp;*.raw;*.mem;*.vmem|All Files (*.*)|*.*",
      "installHint": "Jalankan setup_tools.ps1 (clone + pip install volatility3)",
      "aiHint": "Gunakan untuk memory dump. Mulai windows.info, lalu pslist/pstree, netscan, malfind, cmdline untuk mencari proses jahat dan koneksi C2."
    },
